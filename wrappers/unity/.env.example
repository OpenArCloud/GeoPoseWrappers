# For the desktop token helper / your backend, NEVER a Unity asset or player setting:
MULTISET_CLIENT_ID=
MULTISET_CLIENT_SECRET=
# A short-lived bearer token can be supplied to the Editor process:
MULTISET_ACCESS_TOKEN=
# Optional; public CDS reads generally do not require a token:
OSCP_CDS_ACCESS_TOKEN=
# Other endpoint entries can name their own bearerTokenEnvironment variable.
